  var seen = {}, out = [];
  t.rows.forEach(function (r) {
    var n = fsStr(r[ni]); if (!n || seen[n.toLowerCase()]) return; seen[n.toLowerCase()] = 1;
    out.push({ name: n, linkedin_url: li === undefined ? null : (fsEmptyNull(r[li])) });
  });
  fsChunks(out, 200).forEach(function (ch) { fsReq('post', 'founders?on_conflict=name', ch, 'resolution=merge-duplicates,return=minimal'); });
  return 'Founders: ' + out.length + ' updated.';
}

function fsPullFounders() {
  fsEnsureTab(FS_TAB.founders, FS_FOUNDER_HEAD);
  var sh = fsSheet(FS_TAB.founders);
  var fl = fsGetAll('founders', 'select=name,linkedin_url&order=name.asc'), biz = {};
  fsGetAll('startups', 'select=name,founders,status').forEach(function (s) {
    if (s.status !== 'published') return;
    (s.founders || []).forEach(function (f) { (biz[f.toLowerCase()] = biz[f.toLowerCase()] || []).push(s.name); });
  });
  var bk = fsBackup(sh);
  fsWriteTab(sh, FS_FOUNDER_HEAD, fl.map(function (f) { return [f.name, f.linkedin_url || '', (biz[f.name.toLowerCase()] || []).join(', ')]; }), []);
  return 'Founders: ' + fl.length + ' loaded.';
}

/* ====================== 07-SiteTabs.gs ====================== */
/**
 * SiteTabs: Settings, Nav, Pages, Team and Highlights tabs (all site text).
 * Part of the Failed Startups Sheet control script (see SETUP.md). Every file shares one global scope.
 */

function fsSiteRows(key, t) {
  var spec = FS_SITE[key], out = [];
  t.rows.forEach(function (row, n) {
    var o = {}, ok = true;
    spec.map.forEach(function (m) {
      var i = t.idx[fsNormH(m[0])], v = i === undefined ? '' : row[i], ty = m[2], s = fsStr(v);
      if (ty === 'b') o[m[1]] = !/^(no|false|0|hide|hidden|n)$/i.test(s);
      else if (ty === 'i') { var p = parseInt(s, 10); o[m[1]] = isFinite(p) ? p : (n + 1); }
      else if (ty === 'l') { s = s.toLowerCase(); o[m[1]] = (s === 'header' || s === 'footer') ? s : 'both'; }
      else if (ty === 'S' || ty === 'k') { if (!s) ok = false; o[m[1]] = s; }
      else o[m[1]] = (typeof v === 'string' ? v.replace(/^\s+|\s+$/g, '') : s);
    });
    if (ok) out.push(o);
  });
  return out;
}

function fsPublishSite(key) {
  var spec = FS_SITE[key], sh = fsSheetOrNull(spec.tab);
  if (!sh) return spec.tab + ': tab missing, skipped.';
  var rows = fsSiteRows(key, fsReadTab(sh));
  if (!rows.length) return spec.tab + ': tab is empty, skipped (protecting the live site).';
  if (key === 'settings') {
    var seen = {}; rows = rows.filter(function (r) { if (seen[r.key]) return false; seen[r.key] = 1; return true; });
    fsReq('post', 'site_settings?on_conflict=key', rows, 'resolution=merge-duplicates,return=minimal');
    var gone = fsGetAll('site_settings', 'select=key').map(function (r) { return r.key; })
      .filter(function (k) { return !seen[k] && !FS_PROTECTED_SETTINGS[k]; });
    fsChunks(gone, 40).forEach(function (ch) {
      fsReq('delete', 'site_settings?key=in.(' + ch.map(function (k) { return '"' + k.replace(/"/g, '') + '"'; }).join(',') + ')', undefined, 'return=minimal');
    });
  } else {
    var old = fsGetAll(spec.table, 'select=id').map(function (r) { return r.id; });
    fsChunks(rows, 200).forEach(function (ch) { fsReq('post', spec.table, ch, 'return=minimal'); });   // add new first...
    fsChunks(old, 100).forEach(function (ch) { fsReq('delete', spec.table + '?id=in.(' + ch.join(',') + ')', undefined, 'return=minimal'); }); // ...then remove old
  }
  return spec.tab + ': ' + rows.length + ' rows published.';
}

function fsPullSite(key) {
  var spec = FS_SITE[key], header = spec.map.map(function (m) { return m[0]; });
  fsEnsureTab(spec.tab, header);
  var sh = fsSheet(spec.tab), order = spec.map.some(function (m) { return m[1] === 'sort_order'; });
  var recs = fsGetAll(spec.table, 'select=*&order=' + (order ? 'sort_order.asc,id.asc' : 'key.asc'));
  var plain = []; spec.map.forEach(function (m, i) { if (m[2] === 'i') plain.push(i); });
  var rows = recs.map(function (r) {
    return spec.map.map(function (m) {
      var v = r[m[1]];
      if (m[2] === 'b') return v === false ? 'No' : 'Yes';
      return v == null ? '' : v;
    });
  });
  var bk = fsBackup(sh);
  fsWriteTab(sh, header, rows, plain);
  if (spec.map.some(function (m) { return m[2] === 'b'; })) fsDropdown(sh, 'Visible', ['Yes', 'No']);
  return spec.tab + ': ' + rows.length + ' loaded.';
}

/* ====================== 08-Inbox.gs ====================== */
/**
 * Inbox: Missed Searches and Submissions tabs (Supabase to Sheet, status back to Supabase).
 * Part of the Failed Startups Sheet control script (see SETUP.md). Every file shares one global scope.
 */

function fsPushFlags() {                // Sheet -> Supabase: only status/reviewed changes
  var n = 0, sh = fsSheetOrNull(FS_TAB.misses);
  if (sh && sh.getLastRow() > 1) {
    var t = fsReadTab(sh), ti = t.idx.term, si = t.idx.status;
    if (ti !== undefined && si !== undefined) {
      var db = {}; fsGetAll('search_misses', 'select=term,status').forEach(function (r) { db[r.term] = r.status; });
      t.rows.forEach(function (r) {
        var term = fsStr(r[ti]), st = fsStr(r[si]).toLowerCase();
        if (db[term] !== undefined && /^(new|added|ignored)$/.test(st) && db[term] !== st) {
          fsReq('patch', 'search_misses?term=eq.' + encodeURIComponent(term), { status: st }, 'return=minimal'); n++;
        }
      });
    }
  }
  sh = fsSheetOrNull(FS_TAB.submissions);
  if (sh && sh.getLastRow() > 1) {
    var s = fsReadTab(sh), ii = s.idx.id, ri = s.idx.reviewed;
    if (ii !== undefined && ri !== undefined) {
      var d2 = {}; fsGetAll('submissions', 'select=id,reviewed').forEach(function (r) { d2[r.id] = r.reviewed; });
      s.rows.forEach(function (r) {
        var id = fsStr(r[ii]), val = r[ri] === true || /^(true|yes)$/i.test(fsStr(r[ri]));
        if (d2[id] !== undefined && d2[id] !== val) { fsReq('patch', 'submissions?id=eq.' + id, { reviewed: val }, 'return=minimal'); n++; }
      });
    }
  }
  return n;
}

function fsPullInbox() {                // Supabase -> Sheet (after pushing flags, so nothing you ticked is lost)
  fsPushFlags();
  var msg = [], tz = Session.getScriptTimeZone();
  var miss = fsGetAll('search_misses', 'select=*&order=hits.desc,last_seen.desc');
  fsEnsureTab(FS_TAB.misses, FS_MISS_HEAD);
  var sh = fsSheet(FS_TAB.misses);
  fsWriteTab(sh, FS_MISS_HEAD, miss.map(function (r) {
    return [r.term, r.hits, Utilities.formatDate(new Date(r.first_seen), tz, 'yyyy-MM-dd HH:mm'), Utilities.formatDate(new Date(r.last_seen), tz, 'yyyy-MM-dd HH:mm'), r.status];
  }), [1]);
  fsDropdown(sh, 'Status', ['new', 'added', 'ignored']);
  msg.push('Missed Searches: ' + miss.length);

  var subs = fsGetAll('submissions', 'select=*&order=created_at.desc');
  fsEnsureTab(FS_TAB.submissions, FS_SUB_HEAD);
  sh = fsSheet(FS_TAB.submissions);
  fsWriteTab(sh, FS_SUB_HEAD, subs.map(function (r) {
    var p = r.payload || {};
    return [r.id, Utilities.formatDate(new Date(r.created_at), tz, 'yyyy-MM-dd HH:mm'), !!r.reviewed, p.startupName || '', p.startupWebsite || '',
      p.tagline || '', p.sector || '', p.foundedYear || '', p.shutdownYear || '', p.failureReason || '', p.notes || '',
      p.submitterName || '', p.submitterEmail || '', p.relationship || '', p.formType || ''];
  }), [2]);
  if (subs.length) sh.getRange(2, 3, subs.length, 1).setNumberFormat('General').insertCheckboxes();
  msg.push('Submissions: ' + subs.length);
  return msg.join(', ');
}

function fsMenuRefreshInbox() { fsGuard(fsPullInbox); }

function fsMenuAddSubmission() {
  fsGuard(function () {
    var sh = SpreadsheetApp.getActiveSheet();
    if (sh.getName() !== FS_TAB.submissions) return 'Click a row in the "' + FS_TAB.submissions + '" tab first.';
    var r = sh.getActiveRange().getRow(); if (r < 2) return 'Click a submission row (not the header).';
    var t = fsReadTab(sh), row = sh.getRange(r, 1, 1, t.header.length).getValues()[0], g = function (h) { return fsStr(row[t.idx[fsNormH(h)]]); };
    if (!g('Startup')) return 'That row has no startup name.';
    var st = fsSheet(FS_TAB.startups), tt = fsReadTab(st), vals = {
      'Startup Name': g('Startup'), 'Tagline / Description': g('Tagline'), 'Website URL': g('Website'), 'Sector': g('Sector'),
      'Founded In': g('Founded'), 'Shutdown Year': g('Shutdown'), 'Failure Reason': g('Failure reason'), 'Visible': 'No'
    };
    var exists = tt.rows.some(function (x) { return fsKey(x[tt.idx.startupname]) === fsKey(vals['Startup Name']); });
    if (exists) return '"' + vals['Startup Name'] + '" is already in the startup list.';
    var line = tt.header.map(function (h) { var v = vals[fsStr(h)]; return v === undefined ? '' : v; });
    st.getRange(st.getLastRow() + 1, 1, 1, line.length).setValues([line]);
    sh.getRange(r, t.idx.reviewed + 1).setValue(true);
    fsPublishStartupRows(st.getLastRow(), st.getLastRow(), { added_by: 'submission' });
    fsPushFlags();
    return 'Added "' + vals['Startup Name'] + '" to the bottom of the startup list as hidden (Visible = No).\nFill in the details, then set Visible to Yes to put it on the site.';
  });
}

/* ====================== 09-Competitors.gs ====================== */
/**
 * Competitors: turns "Zepto, Blinkit, Instamart" in Primary Competition into their own rows.
 * Part of the Failed Startups Sheet control script (see SETUP.md).
 *
 * Runs by itself whenever you edit a startup row (auto-publish must be ON), and from the menu
 * "Add competitors as new rows" for the whole tab. Each competitor name becomes a new row at the bottom
 * of the Failed Startups tab with Visible empty, so it is a lead and not shown on the site.
 * Names already in the tab are skipped (case, spaces and punctuation ignored). Your original
 * Primary Competition text is left exactly as you typed it.
 */

function fsCompetitorNames(text) {
  return fsStr(text).split(/,|;|\n|\s\/\s/).map(function (x) {
    x = x.replace(/^["'\s]+|["'\s]+$/g, '').replace(/\s+/g, ' ').replace(/\betc\.?$/i, '').trim();
    if (x && x === x.toLowerCase()) x = x.replace(/(^|[\s\-])([a-z])/g, function (m, a, b) { return a + b.toUpperCase(); });  // "zepto" -> "Zepto"
    return x;
  }).filter(function (x) {
    return x.length >= 2 && x.length <= 60 && !/^(etc\.?|others?|n\/?a|none|unknown|nil|-)$/i.test(x);
  });
}

// first/last = sheet rows to look at (leave out for the whole tab). Returns the names that were added.
function fsSplitCompetitors(first, last) {
  var sh = fsSheet(FS_TAB.startups), t = fsReadTab(sh), ci = fsStartupColIndex(t);
  if (ci.name === undefined || ci.competitors === undefined) return [];
  first = first || 2; last = last || sh.getLastRow();
  var have = {}, fresh = [];
  t.rows.forEach(function (r) { var k = fsKey(r[ci.name]); if (k) have[k] = 1; });
  t.rows.forEach(function (r) {
    if (r.__row < first || r.__row > last) return;
    var self = fsKey(r[ci.name]); if (!self) return;
    fsCompetitorNames(r[ci.competitors]).forEach(function (c) {
      var k = fsKey(c); if (!k || k === self || have[k]) return;
      have[k] = 1; fresh.push(c);
    });
  });
  if (!fresh.length) return [];
  var rows = fresh.map(function (n) { return t.header.map(function (h) { return fsNormH(h) === 'startupname' ? n : ''; }); });
  var start = sh.getLastRow() + 1;
  sh.getRange(start, 1, rows.length, t.header.length).setValues(rows);
  fsPublishStartupRows(start, start + rows.length - 1, { added_by: 'competitor' });
  return fresh;
}

function fsMenuAddCompetitors() {
  fsGuard(function () {
    var added = fsSplitCompetitors();
    fsHighlightDuplicates();
    return added.length
      ? 'Added ' + added.length + ' competitor rows (not visible on the site):\n' + added.slice(0, 15).join(', ') + (added.length > 15 ? ', …' : '') +
        '\n\nThis does not check how old a company is. Delete leads you do not want.'
      : 'No new competitor names found. Everything in Primary Competition already has its own row.';
  });
}

/* ====================== 10-Duplicates.gs ====================== */
/**
 * Duplicates: paints every duplicate startup name yellow in the Failed Startups tab.
 * Part of the Failed Startups Sheet control script (see SETUP.md).
 *
 * "Duplicate" = same name ignoring capital letters, spaces and punctuation ("Zilingo", "zi lingo", "ZI-LINGO").
 * ALL copies are highlighted so you can see them. Only the first copy is published to the site; later copies are skipped.
 * Delete or rename the extra row and the yellow goes away on the next edit.
 */
var FS_DUP_COLOR = '#ffeb3b';

// returns the list of duplicate names found
function fsHighlightDuplicates() {
  var sh = fsSheetOrNull(FS_TAB.startups);
  if (!sh || sh.getLastRow() < 2) return [];
  var t = fsReadTab(sh), ni = t.idx[fsNormH('Startup Name')];
  if (ni === undefined) return [];
  var rng = sh.getRange(2, ni + 1, sh.getLastRow() - 1, 1), vals = rng.getValues(), bgs = rng.getBackgrounds();
  var count = {}, dupNames = [], changed = false;
  vals.forEach(function (v) { var k = fsKey(v[0]); if (k) count[k] = (count[k] || 0) + 1; });
  for (var i = 0; i < vals.length; i++) {
    var k = fsKey(vals[i][0]), isDup = !!k && count[k] > 1, now = String(bgs[i][0]).toLowerCase();
    if (isDup) {
      dupNames.push(fsStr(vals[i][0]));
      if (now !== FS_DUP_COLOR) { bgs[i][0] = FS_DUP_COLOR; changed = true; }
    } else if (now === FS_DUP_COLOR) { bgs[i][0] = null; changed = true; }   // no longer a duplicate: remove our yellow only
  }
  if (changed) rng.setBackgrounds(bgs);
  return fsUniq(dupNames);
}

function fsMenuHighlightDuplicates() {
  fsGuard(function () {
    var d = fsHighlightDuplicates();
    return d.length ? d.length + ' duplicate names are highlighted in yellow:\n' + d.slice(0, 20).join(', ') : 'No duplicate startup names.';
  });
}

/* ====================== 11-ContactForm.gs ====================== */
/**
 * Contact form: saves each message from the website's Contact page in the "Contact" tab and emails you.
 * Part of the Failed Startups Sheet control script (see SETUP.md).
 *
 * The website already sends the form to the Settings key  contact_form_url.  Put the Web app URL there
 * (SETUP.md, "Contact form"). Visitors never see the Sheet or your email address.
 * Mail goes to the address set with the menu "Contact form > Set notification email" (default: the Sheet owner).
 */
var FS_CONTACT_HEAD = ['Received', 'Name', 'Email', 'Message', 'Status', 'Notes'];

function fsOneLine(v, max) { return String(v == null ? '' : v).replace(/[\r\n\t]+/g, ' ').replace(/\s+/g, ' ').trim().slice(0, max); }

function fsContactTo() {
  return fsProp('CONTACT_NOTIFY') || Session.getEffectiveUser().getEmail();
}

// d = {name, email, message} from the website. Returns {ok:true} or {ok:false,error}.
function fsContactHandle(d) {
  var name = fsOneLine(d.name, 100), email = fsOneLine(d.email, 200), msg = String(d.message == null ? '' : d.message).trim().slice(0, 5000);
  if (!name || !msg || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return { ok: false, error: 'invalid' };

  var cache = CacheService.getScriptCache();
  var dupKey = 'c' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_1, email + '|' + msg)).slice(0, 30);
  if (cache.get(dupKey)) return { ok: true };                          // same message just sent: do not save or email twice
  var n = parseInt(cache.get('rate') || '0', 10);
  if (n >= 40) return { ok: false, error: 'busy' };                    // flood guard: 40 messages per hour
  cache.put('rate', String(n + 1), 3600); cache.put(dupKey, '1', 600);

  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return { ok: false, error: 'busy' };
  var sheet;
  try {
    var created = fsEnsureTab(FS_TAB.contact, FS_CONTACT_HEAD);
    sheet = fsSheet(FS_TAB.contact);
    if (created) fsDropdown(sheet, 'Status', ['New', 'Replied', 'Done', 'Spam']);
    var row = sheet.getLastRow() + 1;
    sheet.getRange(row, 1, 1, 6).setNumberFormats([['yyyy-mm-dd hh:mm', '@', '@', '@', '@', '@']])          // text format: nobody can inject a formula
      .setValues([[new Date(), name, email, msg, 'New', '']]);
  } finally { lock.releaseLock(); }

  try {
    var when = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm');
    MailApp.sendEmail({
      to: fsContactTo(), replyTo: email, name: 'Failed Startups website',
      subject: 'New message on Failed Startups from ' + name,
      body: 'Someone sent a message through the Contact page.\n\nName: ' + name + '\nEmail: ' + email + '\nTime: ' + when +
        '\n\nMessage:\n' + msg + '\n\n---\nPress Reply to answer them directly.\nAll messages: ' + SpreadsheetApp.getActive().getUrl() + '#gid=' + sheet.getSheetId()
    });
  } catch (err) { console.log('Contact saved but email failed: ' + err.message); }   // the message is safe in the Sheet either way
  return { ok: true };
}

function fsMenuContactSetEmail() {
  var ui = SpreadsheetApp.getUi();
  var r = ui.prompt('Contact form notifications', 'Send an email to this address for every new message.\nNow: ' + fsContactTo(), ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  var e = r.getResponseText().trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)) return fsSay('That does not look like an email address.');
  PropertiesService.getScriptProperties().setProperty('CONTACT_NOTIFY', e);
  fsSay('Saved. New messages will be emailed to ' + e + '.\nUse "Send a test message" to check it.');
}

function fsMenuContactTest() {
  var r = fsContactHandle({ name: 'Test message', email: 'test@example.com', message: 'This is a test from the Failed Startups menu (' + new Date().toISOString() + ').' });
  fsSay(r.ok ? 'Test sent. A row was added to the Contact tab and an email should reach ' + fsContactTo() + ' within a minute (check Spam too).\nThe first run asks Google for permission to send email: that is expected.' : 'Test failed: ' + r.error);
}

/* ====================== 12-WebApp.gs ====================== */
/**
 * Web app: the single public address (URL) the website talks to.
 * Part of the Failed Startups Sheet control script (see SETUP.md).
 *
 * Deploy > New deployment > Web app > Execute as: Me > Who has access: Anyone.
 * It serves the Contact form now and, later, Buy Me a Beer. Apps Script allows only ONE doPost per project,
 * so this file is the router: it hands each request to the right file.
 *  - {formType:"contact", ...}      -> 11-ContactForm.gs
 *  - {action:"order"|"verify", ...} -> support-backend.gs (supportPost), if you have added that file
 * After you change any code: Deploy > Manage deployments > pencil > Version: New version > Deploy (the URL stays the same).
 */
function fsJson(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }

function doPost(e) {
  try {
    var d = JSON.parse(e.postData.contents);
    if (d && d.formType === 'contact') return fsJson(fsContactHandle(d));
    if (typeof supportPost === 'function') return supportPost(e);
    return fsJson({ ok: false, error: 'not configured' });
  } catch (err) { return fsJson({ ok: false, error: 'bad request' }); }
}

function doGet() {
  if (typeof supportGet === 'function') return supportGet();
  return fsJson({ ok: true, service: 'failed-startups' });
}

/* ====================== 13-AutoPublish.gs ====================== */
/**
 * AutoPublish: Triggers: publish automatically when you edit the Sheet (also splits competitors and highlights duplicates).
 * Part of the Failed Startups Sheet control script (see SETUP.md). Every file shares one global scope.
 */

function fsAutoOn() {
  fsAutoOff(true);
  var ss = SpreadsheetApp.getActive();
  ScriptApp.newTrigger('fsOnEdit').forSpreadsheet(ss).onEdit().create();
  ScriptApp.newTrigger('fsOnChange').forSpreadsheet(ss).onChange().create();
  ScriptApp.newTrigger('fsPeriodic').timeBased().everyMinutes(30).create();
  fsSay('Auto-publish is ON.\nEvery edit goes live within seconds. Every 30 minutes the Missed Searches and Submissions tabs refresh by themselves.\n\nTo remove a startup from the site: set Visible to No (or delete its row).');
}

function fsAutoOff(quiet) {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (['fsOnEdit', 'fsOnChange', 'fsPeriodic'].indexOf(t.getHandlerFunction()) >= 0) ScriptApp.deleteTrigger(t);
  });
  if (quiet !== true) fsSay('Auto-publish is OFF. Use "Publish everything" when you want to go live.');
}

function fsOnEdit(e) {
  try {
    if (!e || !e.range) return;
    var sh = e.range.getSheet(), name = sh.getName(), siteKey = null;
    FS_SITE_ORDER.forEach(function (k) { if (FS_SITE[k].tab === name) siteKey = k; });
    if (name !== FS_TAB.startups && name !== FS_TAB.founders && name !== FS_TAB.misses && name !== FS_TAB.submissions && !siteKey) return;
    var msg = fsWithLock(function () {
      if (name === FS_TAB.startups) {
        var r1 = Math.max(2, e.range.getRow()), r2 = Math.min(e.range.getLastRow(), sh.getLastRow());
        if (r2 < r1) return null;
        var t = fsReadTab(sh), ci = fsStartupColIndex(t);
        // someone cleared a whole row: do a full pass so the site drops it
        var blank = false;
        for (var r = r1; r <= r2; r++) { var row = t.rows[r - 2]; if (row && !fsStr(row[ci.name])) blank = true; }
        if (blank) return fsPublishStartups();
        // single-cell rename: carry the old record over instead of leaving a stale copy
        if (e.oldValue !== undefined && r1 === r2 && e.range.getNumColumns() === 1 && e.range.getColumn() - 1 === ci.name && e.value) {
          var ok = fsKey(e.oldValue), nk = fsKey(e.value);
          if (ok && ok !== nk) { try { fsReq('patch', 'startups?name_key=eq.' + ok, { name: String(e.value).trim() }, 'return=minimal'); } catch (x) { /* new name already exists: the upsert below handles it */ } }
        }
        var res = fsPublishStartupRows(r1, r2, {});
        var added = fsSplitCompetitors(r1, r2);            // 09-Competitors.gs: each competitor name gets its own row
        var dups = fsHighlightDuplicates();                // 10-Duplicates.gs: duplicates turn yellow
        return 'Published ' + res.sent + ' startup row(s)' +
          (added.length ? '. New competitor rows: ' + added.slice(0, 4).join(', ') + (added.length > 4 ? '…' : '') : '') +
          (dups.length ? '. ' + dups.length + ' duplicate name(s) in yellow, only the first is on the site' : '');
      }
      if (name === FS_TAB.founders) return fsPublishFounders();
      if (name === FS_TAB.misses || name === FS_TAB.submissions) { fsPushFlags(); return 'Saved'; }
      return fsPublishSite(siteKey);
    });
    if (msg) fsToast('Live: ' + msg);
  } catch (err) { fsToast('NOT published: ' + err.message); }
}

function fsOnChange(e) {
  try {
    if (!e || e.changeType !== 'REMOVE_ROW') return;
    fsWithLock(function () { return fsPublishAll(); });
    fsToast('Row removed: site updated.');
  } catch (err) { fsToast('NOT published: ' + err.message); }
}

function fsPeriodic() {
  try { fsWithLock(function () { return fsPullInbox(); }); } catch (err) { console.log(err.message); }
}

/* ====================== 14-Menu.gs ====================== */
/**
 * Menu: The "Failed Startups" menu and the publish-everything / load-everything actions.
 * Part of the Failed Startups Sheet control script (see SETUP.md). Every file shares one global scope.
 */

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Failed Startups')
    .addItem('1. Connect to Supabase…', 'fsMenuConnect')
    .addItem('2. Create missing tabs', 'fsMenuSetup')
    .addItem('3. Turn auto-publish ON', 'fsAutoOn')
    .addSeparator()
    .addItem('Publish everything to the website', 'fsMenuPublishAll')
    .addItem('Publish this tab only', 'fsMenuPublishTab')
    .addItem('Compare Sheet with Supabase (no changes)', 'fsMenuCompare')
    .addSeparator()
    .addItem('Refresh Missed Searches + Submissions', 'fsMenuRefreshInbox')
    .addItem('Add selected submission to the startup list', 'fsMenuAddSubmission')
    .addSeparator()
    .addItem('Add competitors as new rows (whole tab)', 'fsMenuAddCompetitors')
    .addItem('Highlight duplicate startups now', 'fsMenuHighlightDuplicates')
    .addSeparator()
    .addSubMenu(SpreadsheetApp.getUi().createMenu('Contact form')
      .addItem('Set notification email…', 'fsMenuContactSetEmail')
      .addItem('Send a test message', 'fsMenuContactTest'))
    .addSeparator()
    .addItem('Load everything FROM Supabase (first-time / reset)…', 'fsMenuLoadAll')
    .addItem('Turn auto-publish OFF', 'fsAutoOff')
    .addItem('Test connection', 'fsMenuTest')
    .addToUi();
}

function fsMenuSetup() {
  var made = [];
  if (fsEnsureTab(FS_TAB.startups, FS_STARTUP_COLS.slice(0, 23).map(function (c) { return c[0]; }))) made.push(FS_TAB.startups);
  if (fsEnsureTab(FS_TAB.founders, FS_FOUNDER_HEAD)) made.push(FS_TAB.founders);
  FS_SITE_ORDER.forEach(function (k) { if (fsEnsureTab(FS_SITE[k].tab, FS_SITE[k].map.map(function (m) { return m[0]; }))) made.push(FS_SITE[k].tab); });
  if (fsEnsureTab(FS_TAB.misses, FS_MISS_HEAD)) made.push(FS_TAB.misses);
  if (fsEnsureTab(FS_TAB.submissions, FS_SUB_HEAD)) made.push(FS_TAB.submissions);
  if (fsEnsureTab(FS_TAB.contact, FS_CONTACT_HEAD)) made.push(FS_TAB.contact);
  fsDropdown(fsSheet(FS_TAB.contact), 'Status', ['New', 'Replied', 'Done', 'Spam']);
  fsDropdown(fsSheet(FS_TAB.startups), 'Visible', ['Yes', 'No', 'Pending']);
  FS_SITE_ORDER.forEach(function (k) { if (FS_SITE[k].map.some(function (m) { return m[2] === 'b'; })) fsDropdown(fsSheet(FS_SITE[k].tab), 'Visible', ['Yes', 'No']); });
  fsSay(made.length ? 'Created: ' + made.join(', ') + '.\nNow use "Load everything FROM Supabase" to fill them with what the live site has today.' : 'All tabs already exist.');
}

function fsPublishAll() {
  var out = [fsPublishStartups(), fsPublishFounders()];
  FS_SITE_ORDER.forEach(function (k) { out.push(fsPublishSite(k)); });
  out.push('Inbox flags pushed: ' + fsPushFlags());
  return out.join('\n');
}

function fsMenuPublishAll() {
  if (!fsAsk('Publish every tab to the live website now?\n\nThe Sheet becomes the master: anything on the site that is not in the Sheet is replaced (startups that are not in the Sheet are hidden, never deleted).')) return;
  fsGuard(fsPublishAll);
}

function fsMenuPublishTab() {
  var name = SpreadsheetApp.getActiveSheet().getName();
  fsGuard(function () {
    if (name === FS_TAB.startups) return fsPublishStartups();
    if (name === FS_TAB.founders) return fsPublishFounders();
    for (var i = 0; i < FS_SITE_ORDER.length; i++) if (FS_SITE[FS_SITE_ORDER[i]].tab === name) return fsPublishSite(FS_SITE_ORDER[i]);
    if (name === FS_TAB.misses || name === FS_TAB.submissions) return 'Inbox flags pushed: ' + fsPushFlags();
    return '"' + name + '" is not a website tab, nothing to publish.';
  });
}

function fsMenuLoadAll() {
  if (!fsAsk('Replace the Sheet tabs with what is in Supabase right now?\n\nUse this once to start, or to throw away Sheet edits. Each tab that has data is first saved as a hidden "Backup …" tab.')) return;
  fsGuard(function () {
    var out = [fsPullStartups(), fsPullFounders()];
    FS_SITE_ORDER.forEach(function (k) { out.push(fsPullSite(k)); });
    out.push(fsPullInbox());
    out.push('\nTip: turn on "3. Turn auto-publish ON" so every edit goes live by itself.');
    return out.join('\n');
  });
}

/* ====================== 15-BuyMeABeer.gs ====================== */
/**
 * Buy Me a Beer backend (Google Apps Script) for Failed Startups.
 * Verifies every payment with Razorpay's API BEFORE it counts toward the leaderboard.
 *
 * SETUP (details in SUPPORT-SETUP.md)
 *  NOTE: this file no longer has its own doGet/doPost. 12-WebApp.gs (in sheet-control/apps-script) is the one public
 *  entry point and calls supportGet / supportPost below, so the Contact form and Buy Me a Beer share ONE web app URL.
 *  1. In your Google Sheet: Extensions > Apps Script. Add this file next to the sheet-control files.
 *  2. Project Settings > Script properties: add RZP_KEY_ID and RZP_KEY_SECRET (from the Razorpay dashboard).
 *  3. Deploy > New deployment > Web app. Execute as: Me. Who has access: Anyone. Copy the /exec URL.
 *  4. Put that URL in the Settings tab of your site sheet:  support_api_url
 */
var MIN_AMOUNT = 10, MAX_AMOUNT = 100000;      // rupees; must match the site (preset tiers and custom amounts are all allowed in this range)
var SHEET = 'Supporters';
var HEAD = ['Time', 'Payment ID', 'Order ID', 'Name', 'Amount (INR)', 'Status'];

function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function prop_(k) { return PropertiesService.getScriptProperties().getProperty(k); }
function auth_() { return 'Basic ' + Utilities.base64Encode(prop_('RZP_KEY_ID') + ':' + prop_('RZP_KEY_SECRET')); }
function sheet_() {
  var ss = SpreadsheetApp.getActive(), sh = ss.getSheetByName(SHEET);
  if (!sh) { sh = ss.insertSheet(SHEET); sh.appendRow(HEAD); sh.setFrozenRows(1); }
  return sh;
}
function cleanName_(n) {
  n = String(n || '').replace(/[^\p{L}\p{N} ._@-]/gu, '').replace(/\s+/g, ' ').trim().slice(0, 20);
  return n.length >= 2 ? n : 'Anonymous Drinker';
}
function rzp_(method, path, body) {
  var o = { method: method, headers: { Authorization: auth_() }, muteHttpExceptions: true, contentType: 'application/json' };
  if (body) o.payload = JSON.stringify(body);
  var r = UrlFetchApp.fetch('https://api.razorpay.com/v1' + path, o);
  var j = JSON.parse(r.getContentText() || '{}');
  if (r.getResponseCode() >= 300) throw new Error((j.error && j.error.description) || 'Razorpay error ' + r.getResponseCode());
  return j;
}

function top5_() {
  var cache = CacheService.getScriptCache(), hit = cache.get('top5');
  if (hit) return JSON.parse(hit);
  var rows = sheet_().getDataRange().getValues().slice(1), agg = {};
  rows.forEach(function (r) {
    if (r[5] !== 'paid') return;
    var name = String(r[3]), k = name.toLowerCase();
    var a = agg[k] || (agg[k] = { name: name, total: 0, count: 0 });
    a.total += Number(r[4]) || 0; a.count++;
  });
  var top = Object.keys(agg).map(function (k) { return agg[k]; })
    .sort(function (x, y) { return y.total - x.total; }).slice(0, 5);
  cache.put('top5', JSON.stringify(top), 20);
  return top;
}

function supportGet() { try { return json_({ ok: true, top: top5_() }); } catch (e) { return json_({ ok: false, error: String(e) }); } }

function supportPost(e) {
  try {
    var d = JSON.parse(e.postData.contents);
    if (d.action === 'order') return json_(createOrder_(d));
    if (d.action === 'verify') return json_(verify_(d));
    return json_({ ok: false, error: 'bad action' });
  } catch (err) { return json_({ ok: false, error: String(err.message || err) }); }
}

function createOrder_(d) {
  var amt = Number(d.amount);
  if (!isFinite(amt) || amt % 1 !== 0 || amt < MIN_AMOUNT || amt > MAX_AMOUNT) throw new Error('invalid amount');
  var name = cleanName_(d.name);
  var o = rzp_('post', '/orders', { amount: amt * 100, currency: 'INR', receipt: 'gy_' + Date.now(), notes: { name: name } });
  return { ok: true, orderId: o.id, amount: o.amount, keyId: prop_('RZP_KEY_ID') };
}

function hex_(bytes) { return bytes.map(function (b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join(''); }

function verify_(d) {
  var orderId = String(d.orderId || ''), payId = String(d.paymentId || ''), sig = String(d.signature || '');
  var expect = hex_(Utilities.computeHmacSha256Signature(orderId + '|' + payId, prop_('RZP_KEY_SECRET')));
  if (expect !== sig.toLowerCase()) throw new Error('bad signature');
  // Never trust the browser: confirm with Razorpay that this payment is real, for this order, and captured.
  var p = rzp_('get', '/payments/' + encodeURIComponent(payId));
  if (p.order_id !== orderId) throw new Error('order mismatch');
  if (p.status === 'authorized') p = rzp_('post', '/payments/' + encodeURIComponent(payId) + '/capture', { amount: p.amount, currency: 'INR' });
  if (p.status !== 'captured') throw new Error('payment not captured');
  var o = rzp_('get', '/orders/' + encodeURIComponent(orderId));
  var amt = o.amount / 100;
  if (amt < MIN_AMOUNT || amt > MAX_AMOUNT || o.amount !== p.amount) throw new Error('amount mismatch');
  var lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    var sh = sheet_(), ids = sh.getRange(2, 2, Math.max(sh.getLastRow() - 1, 1), 1).getValues().map(function (r) { return r[0]; });
    if (ids.indexOf(payId) < 0) sh.appendRow([new Date(), payId, orderId, cleanName_(o.notes && o.notes.name), amt, 'paid']);
    CacheService.getScriptCache().remove('top5');
  } finally { lock.releaseLock(); }
  return { ok: true, top: top5_() };
}

